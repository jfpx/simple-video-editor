<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Video Selection -->
        <Button
            android:id="@+id/btnSelectVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_video"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSelectedVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No video selected"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"
            android:padding="8dp"
            android:background="#F0F0F0" />

        <!-- Processing Mode Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/processing_mode"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbFastMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fast_mode"
            android:checked="true"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvModeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fast_mode_hint"
            android:textSize="12sp"
            android:textColor="#666666"
            android:padding="4dp"
            android:background="#FFF3E0"
            android:layout_marginBottom="16dp" />

        <!-- Intro Video Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/intro_video"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSelectIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_intro"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSelectedIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_intro_selected"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"
            android:padding="8dp"
            android:background="#F0F0F0" />

        <!-- Rotation Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rotation"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnRotateLeft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rotate_left"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnRotateRight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rotate_right"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etCustomAngle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/angle_hint"
            android:inputType="numberSigned|numberDecimal"
            android:layout_marginBottom="16dp" />

        <!-- Output Resolution Section -->
        <TextView
            android:id="@+id/tvResolutionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/output_resolution"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerResolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:minHeight="48dp" />

        <!-- Playback Speed Section -->
        <TextView
            android:id="@+id/tvSpeedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/playback_speed"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:minHeight="48dp" />

        <!-- Overlay Text Section -->
        <TextView
            android:id="@+id/tvOverlayLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overlay_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etOverlayText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/overlay_text_hint"
            android:inputType="text"
            android:maxLines="2"
            android:layout_marginBottom="24dp" />

        <!-- Process Button -->
        <Button
            android:id="@+id/btnProcess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/process_video"
            android:textSize="18sp"
            android:backgroundTint="#4CAF50" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            style="?android:attr/progressBarStyleHorizontal" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
