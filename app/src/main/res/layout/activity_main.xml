<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Video Selection -->
        <Button
            android:id="@+id/btnSelectVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_video"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSelectedVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No video selected"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"
            android:padding="8dp"
            android:background="#F0F0F0" />

        <!-- Processing Mode Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/processing_mode"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbFastMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fast_mode"
            android:checked="true"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvModeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fast_mode_hint"
            android:textSize="12sp"
            android:textColor="#666666"
            android:padding="4dp"
            android:background="#FFF3E0"
            android:layout_marginBottom="16dp" />

        <!-- Intro Video Section (Old Feature - VideoMerger) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/intro_video"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSelectIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_intro"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSelectedIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_intro_selected"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"
            android:padding="8dp"
            android:background="#F0F0F0" />

        <!-- Intro Template Section (New Feature) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/intro_template"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbEnableIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_intro_template"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutIntroControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/select_template"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerIntroTemplate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/intro_text"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etIntroText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/intro_text_hint"
                android:inputType="text"
                android:maxLines="2"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnSaveTemplate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/save_as_template"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnManageTemplates"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/manage_templates"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTemplatePreview"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="@string/template_preview"
                android:textSize="12sp"
                android:padding="8dp"
                android:gravity="center"
                android:background="#F0F0F0"
                android:layout_marginBottom="8dp" />
        </LinearLayout>

        <!-- Background Music Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/background_music"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSelectMusic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_music"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSelectedMusic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_music_selected"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"
            android:padding="8dp"
            android:background="#F0F0F0" />

        <!-- Video Trimming Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_trimming"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbEnableTrim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_trimming"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutTrimControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/start_time"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"
                    android:layout_gravity="center_vertical" />

                <EditText
                    android:id="@+id/etTrimStart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/start_time_hint"
                    android:inputType="numberDecimal"
                    android:text="0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="s"
                    android:textSize="14sp"
                    android:layout_marginStart="4dp"
                    android:layout_gravity="center_vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/end_time"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"
                    android:layout_gravity="center_vertical" />

                <EditText
                    android:id="@+id/etTrimEnd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/end_time_hint"
                    android:inputType="numberDecimal"
                    android:text="10" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="s"
                    android:textSize="14sp"
                    android:layout_marginStart="4dp"
                    android:layout_gravity="center_vertical" />
            </LinearLayout>
        </LinearLayout>

        <!-- Volume Adjustment Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/volume_adjustment"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbEnableVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_volume_adjustment"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutVolumeControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/volume_level"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
        </LinearLayout>

        <!-- Rotation Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rotation"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnRotateLeft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rotate_left"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnRotateRight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rotate_right"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etCustomAngle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/angle_hint"
            android:inputType="numberSigned|numberDecimal"
            android:layout_marginBottom="16dp" />

        <!-- Output Resolution Section -->
        <TextView
            android:id="@+id/tvResolutionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/output_resolution"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerResolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:minHeight="48dp" />

        <!-- Playback Speed Section -->
        <TextView
            android:id="@+id/tvSpeedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/playback_speed"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:minHeight="48dp" />

        <!-- Overlay Text Section -->
        <TextView
            android:id="@+id/tvOverlayLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overlay_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etOverlayText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/overlay_text_hint"
            android:inputType="text"
            android:maxLines="2"
            android:layout_marginBottom="24dp" />

        <!-- Process Button -->
        <Button
            android:id="@+id/btnProcess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/process_video"
            android:textSize="18sp"
            android:backgroundTint="#4CAF50" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            style="?android:attr/progressBarStyleHorizontal" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
