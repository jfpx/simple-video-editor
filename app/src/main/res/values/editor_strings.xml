    <string name="editor_rotation">旋转</string>
    <string name="editor_angle_hint">顺时针角度（任意有符号整数）</string>
    <string name="editor_seconds">秒</string>
    <string name="editor_resolution_hint">原始：裁剪和旋转后不再缩放。1080 / 720 / 480 指最终输出高度（像素），保持处理后的宽高比。编码器限制可能导致不支持的尺寸被拒绝。</string>
    <string name="editor_music_hint">支持替换音乐：替换全部片段的原音，从头循环播放，到视频结束时停止。未选择音乐时保留原音；音量及静音设置仅影响原音，不影响替换音乐。长按选择按钮可清除音乐。</string>
    <string name="editor_title_hint">在导入片头和主视频之前生成独立的无声标题片段。动画／显示消失方式、时长及外观分别设置；淡入淡出（dissolve）在首尾渐变。可选 3 秒、5 秒或输入毫秒时长。原视频帧背景使用原视频绝对时间，与主视频裁剪时间独立。替换音乐覆盖全部片段。</string>
    <string name="editor_title_style">动画／显示消失方式（不改变外观）</string>
    <string name="editor_title_duration">片头时长</string>
